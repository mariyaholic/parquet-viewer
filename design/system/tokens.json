{
  "version": "0.2.0",
  "status": "button materials generated into native controls; other extended roles and future controls remain proposed",
  "origin": "Current Rust theme catalog plus Uika canonical tokens; extended functional roles are proposals",
  "scale": {
    "spacing_dip": [
      4,
      8,
      12,
      16,
      24,
      32
    ],
    "row_height_dip": {
      "compact": 26,
      "normal": 32,
      "comfortable": 38
    },
    "control_height_dip": 32,
    "target_min_dip": 28,
    "font_pt": {
      "caption": 10.5,
      "body": 12,
      "data": 12,
      "section": 14,
      "title": 18
    },
    "motion_ms": {
      "feedback": 120,
      "panel": 180,
      "reduced": 0
    },
    "focus_width_dip": 2,
    "focus_inset_dip": 2,
    "font_weight": {
      "ui": 400,
      "data": 400,
      "heading": 600
    },
    "button_elevation_dip": 2,
    "button_pressed_offset_dip": 1
  },
  "semantic": {
    "surface.canvas": "{reference.background}",
    "surface.panel": "{reference.panel}",
    "surface.input": "{reference.input}",
    "surface.hover": "{reference.hover}",
    "surface.pressed": "{reference.pressed}",
    "text.primary": "{reference.text}",
    "text.secondary": "{reference.muted}",
    "text.info": "{reference.info}",
    "border.control": "{reference.border}",
    "border.decorative": "{reference.divider}",
    "focus.ring": "{reference.accent}",
    "selection.fill": "{reference.selection}",
    "selection.text": "{reference.text}",
    "selection.outline": "{reference.accent}",
    "action.fill": "{reference.accent}",
    "action.text": "{reference.on_action}",
    "status.success": "{reference.success}",
    "status.warning": "{reference.warning}",
    "status.error": "{reference.error}",
    "ornament.trim": "{reference.ornament}",
    "control.highlight": "{reference.control_highlight}",
    "control.shadow": "{reference.control_shadow}",
    "surface.control": "{reference.control_face}",
    "surface.control-hover": "{reference.control_hover}",
    "surface.control-pressed": "{reference.control_pressed}"
  },
  "components": {
    "command.primary.fill": "{semantic.action.fill}",
    "command.primary.text": "{semantic.action.text}",
    "command.secondary.fill": "{semantic.surface.control}",
    "command.secondary.text": "{semantic.text.primary}",
    "command.hover.fill": "{semantic.surface.control-hover}",
    "command.pressed.fill": "{semantic.surface.control-pressed}",
    "command.boundary": "{semantic.border.control}",
    "input.fill": "{semantic.surface.input}",
    "input.text": "{semantic.text.primary}",
    "input.placeholder": "{semantic.text.secondary}",
    "input.boundary": "{semantic.border.control}",
    "input.invalid": "{semantic.status.error}",
    "grid.fill": "{semantic.surface.panel}",
    "grid.text": "{semantic.text.primary}",
    "grid.header.fill": "{semantic.surface.canvas}",
    "grid.header.text": "{semantic.text.secondary}",
    "grid.rule": "{semantic.border.decorative}",
    "grid.selected.fill": "{semantic.selection.fill}",
    "grid.selected.text": "{semantic.selection.text}",
    "grid.selected.outline": "{semantic.selection.outline}",
    "inspector.fill": "{semantic.surface.panel}",
    "inspector.text": "{semantic.text.primary}",
    "inspector.label": "{semantic.text.secondary}",
    "coverage.text": "{semantic.text.info}",
    "message.success": "{semantic.status.success}",
    "message.warning": "{semantic.status.warning}",
    "message.error": "{semantic.status.error}",
    "tabs.text": "{semantic.text.primary}",
    "tabs.active": "{semantic.focus.ring}",
    "focus.outline": "{semantic.focus.ring}",
    "section.trim": "{semantic.ornament.trim}",
    "command.highlight": "{semantic.control.highlight}",
    "command.shadow": "{semantic.control.shadow}"
  },
